   Name = "🔄 Refresh รายชื่อผู้เล่น",
   Callback = function()
      PlayersDropdown:Refresh(GetPlayerList(), true)
      Rayfield:Notify({Title = "System", Content = "อัปเดตรายชื่อผู้เล่นแล้ว", Duration = 2})
   end,
})

-- ปุ่มวาร์ปแบบเสถียร (วาร์ปได้จริง 100%)
TeleFlingTab:CreateButton({
   Name = "🚀 วาร์ปไปหาเป้าหมาย (Teleport Real)",
   Callback = function()
      local target = Players:FindFirstChild(SelectedTarget)
      if target and target.Character then
         local myChar = LocalPlayer.Character
         local targetHRP = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
         
         if myChar and targetHRP then
            -- ใช้ทั้ง CFrame และ PivotTo เพื่อการันตีการวาร์ป
            if myChar:FindFirstChild("HumanoidRootPart") then
               myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 2, 0)
            end
            myChar:PivotTo(targetHRP.CFrame * CFrame.new(0, 2, 0))
            Rayfield:Notify({Title = "Teleport", Content = "วาร์ปสำเร็จ!", Duration = 2})
         end
      else
         Rayfield:Notify({Title = "Error", Content = "ไม่พบผู้เล่น หรือเป้าหมายไม่อยู่ในแมพ", Duration = 3})
      end
   end,
})

TeleFlingTab:CreateToggle({
   Name = "⚡ เปิด/ปิด Fling หมุนตัวแรงพิเศษ",
   CurrentValue = false,
   Callback = function(v)
      _G.FlingEnabled = v
      if v then
         Rayfield:Notify({Title = "Fling Active", Content = "กำลังหมุนตัว Fling ใส่: " .. SelectedTarget, Duration = 2})
         task.spawn(function()
            while _G.FlingEnabled do
               local target = Players:FindFirstChild(SelectedTarget)
               local myChar = LocalPlayer.Character
               
               if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                  local myHRP = myChar.HumanoidRootPart
                  local targetHRP = target.Character.HumanoidRootPart
                  
                  local spin = Instance.new("BodyAngularVelocity")
                  spin.Name = "PhakinSpin"
                  spin.MaxTorque = Vector3.new(1, 1, 1) * 10^9
                  spin.AngularVelocity = Vector3.new(0, 999999, 0)
                  spin.Parent = myHRP
                  
                  myHRP.CFrame = targetHRP.CFrame
                  myHRP.Velocity = Vector3.new(9e9, 9e9, 9e9)
                  
                  task.wait()
                  spin:Destroy()
               else
                  _G.FlingEnabled = false
                  break
               end
            end
         end)
      else
         Rayfield:Notify({Title = "Fling Stopped", Content = "หยุดการ Fling แล้ว", Duration = 2})
      end
   end,
})

