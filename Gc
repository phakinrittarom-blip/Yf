CombatTab:CreateSlider({
   Name = "FOV Size (ขนาดวงกลมล็อกเป้า)", Range = {50, 500}, Increment = 10, CurrentValue = 150,
   Callback = function(v)
      FOVRadius = v
      FOVCircle.Radius = v
   end,
