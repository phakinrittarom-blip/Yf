local SelectedTargetName = ""
_G.FlingEnabled = false

local function FindPlayer(targetText)
   if not targetText or targetText == "" then return nil end
   for _, p in pairs(Players:GetPlayers()) do
      if p.Name == targetText or p.DisplayName == targetText or string.find(targetText, p.Name) then
         return p
      end
   end
   return nil
end

local function GetPlayerList()
   local List = {}
   for _, p in pairs(Players:GetPlayers()) do
      if p ~= LocalPlayer then
         table.insert(List, p.DisplayName .. " (@" .. p.Name .. ")")
      end
   end
   if #List == 0 then table.insert(List, "ไม่มีผู้เล่นอื่นในเซิร์ฟ") end
   return List
end

local PlayersDropdown = TeleFlingTab:CreateDropdown({
   Name = "เลือกเป้าหมายผู้เล่น",
   Options = GetPlayerList(),
   CurrentOption = "",
   Callback = function(Option)
      local rawName = string.match(Option, "%(@(.-)%)")
      SelectedTargetName = rawName or Option
   end,
})

TeleFlingTab:CreateButton({
   Name = "🔄 Refresh รายชื่อผู้เล่น",
   Callback = function()
      PlayersDropdown:Refresh(GetPlayerList(), true)
      Rayfield:Notify({Title = "System", Content = "อัปเดตรายชื่อผู้เล่นล่าสุดแล้ว", Duration = 2})
   end,
})

TeleFlingTab:CreateButton({
   Name = "🚀 วาร์ปไปหาเป้าหมาย (Teleport Real)",
   Callback = function()
      local target = FindPlayer(SelectedTargetName)
      if target and target.Character then
         local myChar = LocalPlayer.Character
         local targetHRP = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
         
         if myChar and targetHRP then
            if myChar:FindFirstChild("HumanoidRootPart") then
               myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 3, 0)
            end
            myChar:PivotTo(targetHRP.CFrame * CFrame.new(0, 3, 0))
            Rayfield:Notify({Title = "Teleport Success", Content = "วาร์ปไปหา " .. target.DisplayName .. " สำเร็จ!", Duration = 2})
         else
            Rayfield:Notify({Title = "Error", Content = "เป้าหมายไม่มีตัวละครในเกม", Duration = 3})
         end
      else
         Rayfield:Notify({Title = "Error", Content = "ไม่พบผู้เล่น กรุณากด Refresh รายชื่ออีกครั้ง", Duration = 3})
      end
   end,
})

TeleFlingTab:CreateToggle({
   Name = "⚡ เปิด/ปิด Fling หมุนตัวแรงพิเศษ",
   CurrentValue = false,
   Callback = function(v)
      _G.FlingEnabled = v
      if v then
         local target = FindPlayer(SelectedTargetName)
         if not target then
            Rayfield:Notify({Title = "Error", Content = "ไม่พบผู้เล่นที่จะ Fling", Duration = 3})
            _G.FlingEnabled = false
            return
         end
         
         Rayfield:Notify({Title = "Fling Active", Content = "กำลังหมุนตัว Fling ใส่: " .. target.DisplayName, Duration = 2})
         
         task.spawn(function()
            while _G.FlingEnabled do
               local currentTarget = FindPlayer(SelectedTargetName)
               local myChar = LocalPlayer.Character
               
               if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                  local myHRP = myChar.HumanoidRootPart
                  local targetHRP = currentTarget.Character.HumanoidRootPart
                  
                  local spin = Instance.new("BodyAngularVelocity")
                  spin.Name = "PhakinSpin"
                  spin.MaxTorque = Vector3.new(1, 1, 1) * 10^9
                  spin.AngularVelocity = Vector3.new(0, 999999, 0)
                  spin.Parent = myHRP
                  
                  myHRP.CFrame = targetHRP.CFrame
                  myHRP.Velocity = Vector3.new(9e9, 9e9, 9e9)
                  
                  task.wait()
                  spin:Destroy()
               else
                  _G.FlingEnabled = false
                  break
               end
            end
         end)
      else
         Rayfield:Notify({Title = "Fling Stopped", Content = "หยุดการ Fling แล้ว", Duration = 2})
      end
   end,
})

